graph = {
    'A': ['B', 'C'],
    'B': ['A', 'C'],
    'C': ['A', 'B', 'D'],
    'D': ['C']
}

colors = ['Red', 'Green', 'Blue']
result = {}

for node in graph:
    used = [result[n] for n in graph[node] if n in result]
    for color in colors:
        if color not in used:
            result[node] = color
            break

print("Map Coloring:")
for node in result:
    print(node, "->", result[node])
