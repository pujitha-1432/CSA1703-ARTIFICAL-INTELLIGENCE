from itertools import permutations

city = [[0, 10, 15, 20],
        [10, 0, 35, 25],
        [15, 35, 0, 30],
        [20, 25, 30, 0]]

min_cost = 999

for p in permutations([1, 2, 3]):
    cost = city[0][p[0]] + city[p[0]][p[1]] + city[p[1]][p[2]] + city[p[2]][0]
    if cost < min_cost:
        min_cost = cost

print("Minimum Cost =", min_cost)
