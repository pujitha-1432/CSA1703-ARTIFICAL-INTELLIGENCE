best_first(Start, Goal) :-
    search([Start], Goal, []).

search([Goal|_], Goal, _) :-
    write('Goal Reached: '), write(Goal), nl.

search([Current|Rest], Goal, Visited) :-
    write('Visiting: '), write(Current), nl,
    findall(X, edge(Current, X), Children),
    append(Rest, Children, NewList),
    best_node(NewList, Next),
    delete(NewList, Next, Remaining),
    search([Next|Remaining], Goal, [Current|Visited]).

best_node([X], X).

best_node([X,Y|Rest], Best) :-
    h(X,HX),
    h(Y,HY),
    (HX =< HY ->
        best_node([X|Rest], Best)
    ;
        best_node([Y|Rest], Best)
    ).

